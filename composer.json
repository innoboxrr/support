{
    "name": "innoboxrr/support",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\Support\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\Support\\Providers\\AppServiceProvider",
                "Innoboxrr\\Support\\Providers\\AuthServiceProvider",
                "Innoboxrr\\Support\\Providers\\EventServiceProvider",
                "Innoboxrr\\Support\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "require": {
        "giggsey/libphonenumber-for-php": "^9.0",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\Support\\Tests\\": "tests/"
        }
    },
    "description": "Utilidades compartidas por los paquetes Laravel de Innoboxrr: manejo HTTP, formato de peticiones, normalizacion de telefonos y un contenedor de datos."
}
